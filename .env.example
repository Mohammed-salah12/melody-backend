PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/melody-beauty?retryWrites=true&w=majority
JWT_SECRET=<long random string>
NODE_ENV=development
# Temporary fixed verification code (development only). Delete this line for random SMS codes.
FIXED_OTP=00000
# Optional: lets Claude rewrite the "Why this product" text in friendlier words (ranking is unchanged).
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-4-5
# Shop / checkout
# SHIPPING_FEE=12
# FREE_SHIPPING_OVER=0          # e.g. 150 for free shipping on orders of $150+ (0 = never)
# DELIVERY_DAYS=5
# PAYMENT_MODE=test             # test = card orders accepted WITHOUT charging (dev only); live refuses cards until a provider is connected
# BANK_NAME=Bank of Palestine
# BANK_ACCOUNT_NAME=Melody Beauty
# BANK_IBAN=
# SUPPORT_EMAIL=support@melody.beauty
# Clinic / consultations
# CLINIC_TIMEZONE=Asia/Gaza
# CLINIC_TIMEZONE_LABEL=PALESTINE TIME
# CONSULT_MINUTES=45
# FREE_CONSULTATIONS=5
# BOOKING_DAYS_AHEAD=30
# CANCELLATION_HOURS=12
# Video consultations (LiveKit — free cloud project at https://cloud.livekit.io, or self-hosted).
# Leave empty to switch video calls off.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# First start on a fresh database (e.g. Render): sample products + doctors are added when empty,
# and this clinic / doctor login is created if it doesn't exist. AUTO_SEED=off turns it off.
# AUTO_SEED=on
# STAFF_PHONE=+970599111222
# STAFF_NAME=Dr. Eleanor Vance
# STAFF_PASSWORD=Clinic#2026
# STAFF_RESET_PASSWORD=false
